{
  "name": "exocortex-volt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "generate-device-key": "node scripts/generate-device-key.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=24.7"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.8",
    "@peculiar/x509": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}

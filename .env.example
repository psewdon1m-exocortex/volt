# Optional server-only device key for unattended startup. personal.volt can
# always be opened offline with the Access Key without this file.
# Example: node scripts/generate-master-key.js /etc/exocortex/secrets/volt-device.key
VOLT_DEVICE_KEY_HOST_PATH=/etc/exocortex/secrets/volt-device.key
VOLT_DEVICE_KEY_FILE=/run/secrets/volt-device.key
VOLT_ACCESS_KEY_FILE=/run/secrets/volt-access-key
# Development-only alternative when VOLT_ACCESS_KEY_FILE is not set:
VOLT_ACCESS_KEY=
VOLT_PORT=18184
VOLT_DATA_DIR=/app/data
VOLT_VAULT_FILE=/app/data/personal.volt
VOLT_SECURE_COOKIES=false
VOLT_TRUST_PROXY=false
VOLT_AUDIT_RETENTION=10000
# Shared only with Kernel. On different servers, place the same generated value
# in a root-owned file on each host; Kernel reaches Volt through HTTPS.
VOLT_KERNEL_TOKEN_HOST_FILE=/etc/exocortex/secrets/volt-kernel.token
VOLT_KERNEL_TOKEN_FILE=/run/secrets/volt-kernel.token
NEPTUNE_PROJECT_ID=volt
NEPTUNE_SOCKET_DIR=/run/neptune
NEPTUNE_SOCKET_GID=
NEPTUNE_CONTROL_TOKEN_HOST_FILE=/etc/neptune/secrets/volt-control.token
NEPTUNE_EXPORT_TOKEN_HOST_FILE=/etc/neptune/secrets/volt-export.token
UPDATER_SOCKET_DIR=/run/exocortex
UPDATER_SOCKET_GID=
UPDATER_REGISTERED_HEAD_ID=volt-production
UPDATER_CONTROL_TOKEN_HOST_FILE=/etc/exocortex/secrets/volt-updater-control.token

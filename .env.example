# OPERATOR INPUT
KERNEL_URL=https://CHANGE_ME
KERNEL_SERVICE_TOKEN=CHANGE_ME
# Consumed into a root-owned secret file during the first installation.
VOLT_ACCESS_KEY=CHANGE_ME_AT_LEAST_12_CHARACTERS

# GENERATED OR RELEASE-MANAGED
# The installer generates a server-only device key for unattended startup.
# personal.volt can always be opened offline with the Access Key without it.
VOLT_DEVICE_KEY_HOST_PATH=/etc/exocortex/secrets/volt-device.key
VOLT_DEVICE_KEY_FILE=/run/secrets/volt-device.key
VOLT_ACCESS_KEY_HOST_PATH=/etc/exocortex/secrets/volt-access.key
VOLT_ACCESS_KEY_FILE=/run/secrets/volt-access-key
VOLT_SECRETS_GID=CHANGE_ME
VOLT_PORT=18184
VOLT_DATA_DIR=/app/data
VOLT_VAULT_FILE=/app/data/personal.volt
VOLT_SECURE_COOKIES=true
VOLT_AUDIT_RETENTION=10000
VOLT_IMAGE=ghcr.io/psewdon1m-exocortex/volt@sha256:CHANGE_ME_64_HEX_DIGEST
VOLT_VERSION=0.1.1
# Kernel-to-Volt token is configured after login in Volt Settings.
VOLT_KERNEL_URL=http://127.0.0.1:18180
# Updater and Neptune resolve Saturn and release coordinates through Kernel Register.
UPDATER_HEAD_ID=volt
UPDATER_SERVICE_ID=volt
UPDATER_COMPOSE_PROJECT_DIR=/opt/volt
UPDATER_COMPOSE_FILE=compose.production.yaml
UPDATER_COMPOSE_SERVICE=volt
UPDATER_CONTAINER_NAME=exocortex-volt
UPDATER_IMAGE_VARIABLE=VOLT_IMAGE
UPDATER_VERSION_VARIABLE=VOLT_VERSION
UPDATER_LOCAL_HEALTH_URL=http://127.0.0.1:18184/api/v1/health
UPDATER_CONTROL_TOKEN=
NEPTUNE_PROJECT_ID=volt
NEPTUNE_SOCKET_DIR=/run/neptune
NEPTUNE_SOCKET_GID=
NEPTUNE_CONTROL_TOKEN_HOST_FILE=/etc/neptune/secrets/volt-control.token
NEPTUNE_EXPORT_TOKEN_HOST_FILE=/etc/neptune/secrets/volt-export.token
UPDATER_SOCKET_DIR=/run/exocortex
UPDATER_SOCKET_GID=CHANGE_ME
# Compatibility alias for installations created before UPDATER_HEAD_ID.
UPDATER_REGISTERED_HEAD_ID=volt
UPDATER_CONTROL_TOKEN_HOST_FILE=/etc/exocortex/secrets/volt-updater-control.token
UPDATER_PUBLIC_HEALTH_URL=
UPDATER_RESTORE_URL=http://127.0.0.1:18184/api/v1/internal/updater/restore
UPDATER_RESTORE_FIELD=file

# The loopback-published container sees host Nginx through Docker's private
# bridge. Never expand this to a universal CIDR.
VOLT_TRUSTED_PROXIES=172.16.0.0/12
